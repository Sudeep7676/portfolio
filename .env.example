# ---------------------------------------------------------------------------
# Contact form email delivery (src/app/api/contact/route.ts)
#
# Copy to .env.local for local development, and add the same variables in
# Vercel under Project Settings -> Environment Variables for production.
#
# Without RESEND_API_KEY the API returns 503 and the contact form falls back to
# opening the visitor's mail client. It never reports a false success.
# ---------------------------------------------------------------------------

# Required. Create a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to the address in src/data/portfolio.ts
CONTACT_TO=sudeepvishwakarma5456@gmail.com

# Optional. Must be a sender you have verified in Resend.
# The default shared sender below works for testing, but Resend will only
# deliver it to the email address that owns the Resend account.
# Once you verify a domain, use something like: Portfolio <hello@yourdomain.com>
CONTACT_FROM=Portfolio <onboarding@resend.dev>
